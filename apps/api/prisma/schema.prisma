  CHARACTER
  STUDY
  FEE
  TRANSFER
  MIGRATION
  COURSE_COMPLETION
  CUSTOM
}

enum CertificateStatus {
  DRAFT
  ISSUED
  ARCHIVED
  REVOKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  EXCUSED
  FULL_DAY_LEAVE
  HALF_DAY_LEAVE
  SHORT_LEAVE
}

enum LeaveType {
  FULL_DAY
  HALF_DAY
  SHORT_LEAVE
}

enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum QuestionType {
  MCQ
  MSQ
  NUMERICAL
  ASSERTION_REASON
  PARAGRAPH
  MATCHING
  SUBJECTIVE
}

enum LearningStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DoubtStatus {
  OPEN
  ANSWERED
  ESCALATED
  RESOLVED
}

enum LearningTestType {
  PRACTICE
  CHAPTER
  UNIT
  FULL
  MOCK
  ADAPTIVE
}

enum LearningAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

enum StudyMaterialType {
  PDF
  NOTES
  FORMULA_SHEET
  MIND_MAP
  ASSIGNMENT
  DPP
  NCERT_SOLUTION
  PYQ
  SAMPLE_PAPER
  REFERENCE_BOOK
  BLOG
  VIDEO
}

enum LiveClassProvider {
  ZOOM
  GOOGLE_MEET
  JITSI
  OTHER
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model User {
  organizationId           String                     @default("org_default")
  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                       String                     @id @default(cuid())
  email                    String                     @unique
  phone                    String?                    @unique
  passwordHash             String
  name                     String
  role                     Role                       @default(STUDENT)
  avatarUrl                String?
  emailVerifiedAt          DateTime?
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  sessions                 Session[]
  passwordResetTokens      PasswordResetToken[]
  enrollments              Enrollment[]
  lessonProgress           LessonProgress[]
  assignments              AssignmentSubmission[]
  examAttempts             ExamAttempt[]
  notifications            Notification[]
  attendances              Attendance[]
  invoices                 Invoice[]
  auditLogs                AuditLog[]                 @relation("ActorLogs")
  taughtCourses            Course[]                   @relation("InstructorCourses")
  createdCourses           Course[]                   @relation("CourseCreator")
  courseSubjects           CourseSubject[]
  markedAttendances        Attendance[]               @relation("AttendanceMarker")
  branchAssignments        BranchUser[]
  studentProfile           StudentProfile?
  teacherProfile           TeacherProfile?
  assignedEnquiries        Enquiry[]                  @relation("EnquiryCounsellor")
  enquiryFollowUps         EnquiryFollowUp[]          @relation("FollowUpCreator")
  issuedCertificates       Certificate[]              @relation("CertificateIssuer")
  parentChildren           ParentStudent[]            @relation("ParentLinks")
  sentMessages             PortalMessage[]            @relation("MessageSender")
  receivedMessages         PortalMessage[]            @relation("MessageRecipient")
  leaveRequests            LeaveRequest[]
  approvedLeaveRequests    LeaveRequest[] @relation("LeaveRequestApprover")
  authoredAnnouncements    Announcement[]
  employee                 Employee?
  approvedHrLeaves         EmployeeLeave[]            @relation("LeaveApprover")
  reviewedPerformances     PerformanceReview[]        @relation("PerformanceReviewer")
  financeEntries           JournalEntry[]             @relation("FinanceEntryCreator")
  financeApprovals         ExpenseBill[]              @relation("FinanceApprover")
  libraryMember            LibraryMember?
  notificationPreference   NotificationPreference?
  announcementReads        AnnouncementRead[]
  communicationThreads     MessageThreadMember[]
  circularAcknowledgements CircularAcknowledgement[]
  circularDownloads        CircularDownload[]
  eventRsvps               CalendarEventRsvp[]
  inventoryActions         InventoryStockMovement[]
  inventoryRequests        InventoryPurchaseRequest[]
  savedAnalyticsReports    AnalyticsSavedReport[]
  analyticsQueries         AnalyticsAssistantQuery[]
  analyticsAlerts          AnalyticsAlert[]
  doubtThreads             DoubtThread[]              @relation("DoubtStudent")
  assignedDoubts           DoubtThread[]              @relation("DoubtTeacher")
  doubtMessages            DoubtMessage[]
  createdBankQuestions     QuestionBankItem[]         @relation("QuestionCreator")
  reviewedBankQuestions    QuestionBankItem[]         @relation("QuestionReviewer")
  createdLearningTests     LearningTest[]
  learningAttempts         LearningTestAttempt[]
  materialBookmarks        StudyMaterialBookmark[]
  liveClassAttendances     LiveClassAttendance[]
  liveClassInteractions    LiveClassInteraction[]
  gamificationProfile      GamificationProfile?
  earnedBadges             StudentBadge[]
  challengeProgress        ChallengeProgress[]
  uploadedQuestionPapers   ExaminationQuestionPaper[] @relation("QuestionPaperUploader")
  evaluatedAnswerSheets    ExaminationAnswerSheet[] @relation("AnswerSheetEvaluator")
  learningRecommendations  LearningRecommendation[]
  dailyLearningGoals       DailyLearningGoal[]
  teacherAllocationsCreated TeacherAllocation[] @relation("TeacherAllocationCreatedBy")
  teacherAllocationsUpdated TeacherAllocation[] @relation("TeacherAllocationUpdatedBy")
  substitutionsApproved TeacherSubstitution[] @relation("SubstitutionApprover")

  @@index([organizationId])
}

model Session {
  organizationId String   @default("org_default")
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PasswordResetToken {
  organizationId String    @default("org_default")
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([organizationId])
}

model Branch {
  organizationId        String                   @default("org_default")
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  id                    String                   @id @default(cuid())
  branchCode            String                   @unique @map("code")
  branchName            String                   @map("name")
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  phone                 String?
  email                 String?
  managerName           String?
  openingDate           DateTime?
  isActive              Boolean                  @default(true)
  users                 BranchUser[]
  batches               Batch[]
  students              StudentProfile[]
  teachers              TeacherProfile[]
  courses               Course[]
  holidays              Holiday[]
  fees                  Fee[]
  tests                 Test[]
  enquiries             Enquiry[]
  certificates          Certificate[]
  classrooms            Classroom[]
  timetables            Timetable[]
  homeworks             Homework[]
  examinations          Examination[]
  lmsLessons            Lesson[]
  announcements         Announcement[]
  leaveRequests         LeaveRequest[]
  employees             Employee[]
  hrHolidays            HrHoliday[]
  recruitmentCandidates RecruitmentCandidate[]
  payrollRuns           PayrollRun[]
  financialYears        FinancialYear[]
  ledgerAccounts        LedgerAccount[]
  journalEntries        JournalEntry[]
  financeVendors        FinanceVendor[]
  expenseBills          ExpenseBill[]
  financeBanks          FinanceBankAccount[]
  gstConfigurations     GstConfiguration[]
  transportVehicles     TransportVehicle[]
  transportStaff        TransportStaff[]
  transportRoutes       TransportRoute[]
  transportStops        TransportStop[]
  libraryBooks          LibraryBook[]
  libraryMembers        LibraryMember[]
  libraryShelves        LibraryShelf[]
  libraryVendors        LibraryVendor[]
  hostels               Hostel[]
  communicationEvents   CalendarEvent[]
  circulars             Circular[]
  assetCategories       AssetCategory[]
  assets                EnterpriseAsset[]
  inventoryStores       InventoryStore[]
  inventoryVendors      InventoryVendor[]
  maintenanceTickets    AssetMaintenanceTicket[]
  analyticsSnapshots    AnalyticsSnapshot[]
  teacherAllocations    TeacherAllocation[]
  timetablePeriods      TimetablePeriod[]
  teacherDuties         TeacherDuty[]
  substitutions         TeacherSubstitution[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([organizationId])
}

model BranchUser {
  organizationId String @default("org_default")
  branchId       String
  userId         String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([branchId, userId])
  @@index([organizationId])
}

model Category {
  organizationId String   @default("org_default")
  id             String   @id @default(cuid())
  name           String
  slug           String
  courses        Course[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Course {
  organizationId       String          @default("org_default")
  id                   String          @id @default(cuid())
  title                String
  slug                 String          @unique
  courseCode           String          @unique
  shortDescription     String?
  fullDescription      String          @map("description") @db.Text
  courseType           CourseType      @default(OTHER) @map("type")
  classLevel           ClassLevel      @default(OTHER)
  stream               String?
  durationDays         Int?
  regularPricePaise    Int             @map("price")
  salePricePaise       Int?            @map("salePrice")
  registrationFeePaise Int             @default(0)
  admissionFeePaise    Int             @default(0)
  thumbnailUrl         String?
  brochureUrl          String?
  eligibility          String?         @db.Text
  learningOutcomes     String?         @db.Text
  language             String          @default("English")
  mode                 CourseMode      @default(HYBRID)
  status               CourseStatus    @default(DRAFT)
  isFeatured           Boolean         @default(false) @map("featured")
  enrollmentOpen       Boolean         @default(true)
  startDate            DateTime?
  endDate              DateTime?
  branchId             String?
  categoryId           String?
  createdById          String?
  instructorId         String?
  category             Category?       @relation(fields: [categoryId], references: [id])
  branch               Branch?         @relation(fields: [branchId], references: [id])
  createdBy            User?           @relation("CourseCreator", fields: [createdById], references: [id])
  instructor           User?           @relation("InstructorCourses", fields: [instructorId], references: [id])
  modules              Module[]
  enrollments          Enrollment[]
  batches              Batch[]
  assignments          Assignment[]
  subjects             CourseSubject[]
  fees                 Fee[]
  tests                Test[]
  enquiries            Enquiry[]
  certificates         Certificate[]
  timetables           Timetable[]
  homeworks            Homework[]
  examinations         Examination[]
  lmsLessons           Lesson[]        @relation("LmsLessonCourse")
  teacherAllocations   TeacherAllocation[]
  substitutions        TeacherSubstitution[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([title])
  @@index([courseCode])
  @@index([courseType])
  @@index([status])
  @@index([branchId])
  @@index([categoryId])
  @@index([organizationId])
}

model Subject {
  organizationId String          @default("org_default")
  id             String          @id @default(cuid())
  name           String
  code           String
  description    String?         @db.Text
  status         SubjectStatus   @default(ACTIVE)
  legacyReviewStatus SubjectLegacyReviewStatus @default(CONFIRMED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  courses        CourseSubject[]
  teachers       TeacherSubject[]
  tests          Test[]
  timetables     Timetable[]
  homeworks      Homework[]
  examinations   Examination[]
  lmsLessons     Lesson[]
  teacherAllocations TeacherAllocation[]
  substitutions TeacherSubstitution[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, name])
}

model CourseSubject {
  organizationId String  @default("org_default")
  courseId       String
  subjectId      String
  teacherId      String?
  position       Int     @default(0)
  isActive       Boolean @default(true)
  course         Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject        Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher        User?   @relation(fields: [teacherId], references: [id])

  @@id([courseId, subjectId])
  @@index([teacherId])
  @@index([organizationId])
}

model TeacherSubject {
  organizationId String
  teacherId      String
  subjectId      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([teacherId, subjectId])
  @@index([organizationId, subjectId])
  @@index([organizationId, teacherId])
}

model Module {
  organizationId String   @default("org_default")
  id             String   @id @default(cuid())
  title          String
  position       Int
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons        Lesson[]

  @@unique([courseId, position])
  @@index([organizationId])
}

model Lesson {
  organizationId  String             @default("org_default")
  id              String             @id @default(cuid())
  title           String
  position        Int
  type            String
  videoUrl        String?
  content         String?            @db.Text
  description     String?            @db.Text
  notes           String?            @db.Text
  branchId        String?
  courseId        String?
  batchId         String?
  subjectId       String?
  teacherId       String?
  chapter         String?
  homeworkId      String?
  testId          String?
  status          LmsContentStatus   @default(DRAFT)
  videoName       String?
  videoMime       String?
  videoSize       Int?
  videoData       Bytes?
  durationSeconds Int                @default(0)
  preview         Boolean            @default(false)
  moduleId        String
  module          Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  branch          Branch?            @relation(fields: [branchId], references: [id])
  course          Course?            @relation("LmsLessonCourse", fields: [courseId], references: [id])
  batch           Batch?             @relation(fields: [batchId], references: [id])
  subject         Subject?           @relation(fields: [subjectId], references: [id])
  teacher         TeacherProfile?    @relation(fields: [teacherId], references: [id])
  homework        Homework?          @relation(fields: [homeworkId], references: [id])
  test            Test?              @relation(fields: [testId], references: [id])
  attachments     LessonAttachment[]
  progress        LessonProgress[]

  @@unique([moduleId, position])
  @@unique([batchId, subjectId, chapter, title])
  @@index([branchId])
  @@index([courseId])
  @@index([batchId, subjectId])
  @@index([teacherId])
  @@index([status])
  @@index([organizationId])
}

model LessonAttachment {
  organizationId String   @default("org_default")
  id             String   @id @default(cuid())
  lessonId       String
  name           String
  mimeType       String
  size           Int
  data           Bytes
  createdAt      DateTime @default(now())
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([organizationId])
}

model Enrollment {
  organizationId  String           @default("org_default")
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  status          EnrollmentStatus @default(ACTIVE)
  progressPercent Int              @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course           @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@index([organizationId])
}

model LessonProgress {
  organizationId      String    @default("org_default")
  id                  String    @id @default(cuid())
  userId              String
  lessonId            String
  watchedSeconds      Int       @default(0)
  watchPercentage     Int       @default(0)
  lastPositionSeconds Int       @default(0)
  timeSpentSeconds    Int       @default(0)
  quizScore           Decimal?  @db.Decimal(6, 2)
  assignmentStatus    String?
  completed           Boolean   @default(false)
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([organizationId])
}

model Batch {
  organizationId    String           @default("org_default")
  id                String           @id @default(cuid())
  name              String
  code              String           @unique
  branchId          String
  courseId          String?
  academicSession   String           @default("2026-27")
  academicSessionId String
  startsAt          DateTime
  endsAt            DateTime?
  capacity          Int              @default(30)
  timing            String           @default("09:00-10:00")
  days              String[]         @default([])
  classroom         String?
  teacherId         String?
  feesPaise         Int              @default(0)
  status            BatchStatus      @default(ACTIVE)
  remarks           String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  branch            Branch           @relation(fields: [branchId], references: [id])
  session           AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  course            Course?          @relation(fields: [courseId], references: [id])
  teacher           TeacherProfile?  @relation(fields: [teacherId], references: [id])
  attendances       Attendance[]
  students          StudentProfile[]
  fees              Fee[]
  tests             TestBatch[]
  certificates      Certificate[]
  timetables        Timetable[]
  homeworks         Homework[]
  examinations      Examination[]
  lmsLessons        Lesson[]
  announcements     Announcement[]
  calendarEvents    CalendarEvent[]
  teacherAllocations TeacherAllocation[]
  substitutions TeacherSubstitution[]

  @@index([branchId])
  @@index([courseId])
  @@index([teacherId])
  @@index([status])
  @@index([organizationId])
  @@index([academicSessionId])
}

model StudentProfile {
  organizationId       String                       @default("org_default")
  id                   String                       @id @default(cuid())
  userId               String                       @unique
  admissionNo          String                       @unique
  rollNo               String
  gender               Gender
  dateOfBirth          DateTime                     @db.Date
  fatherName           String
  motherName           String
  className            String
  parentMobile         String
  address              String                       @db.Text
  branchId             String
  batchId              String
  academicSession      String
  academicSessionId    String
  admissionDate        DateTime                     @db.Date
  bloodGroup           String?
  category             String?
  aadhaarNo            String?                      @unique
  status               StudentStatus                @default(ACTIVE)
  remarks              String?                      @db.Text
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch               Branch                       @relation(fields: [branchId], references: [id])
  batch                Batch                        @relation(fields: [batchId], references: [id])
  session              AcademicSession              @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  fees                 Fee[]
  testAttempts         TestAttempt[]
  convertedEnquiry     Enquiry?
  certificates         Certificate[]
  homeworkSubmissions  HomeworkSubmission[]
  examinationResults   ExaminationResult[]
  examinationAnswerSheets ExaminationAnswerSheet[]
  parents              ParentStudent[]
  transportAssignments StudentTransportAssignment[]
  transportAttendances TransportAttendance[]
  transportFees        TransportFeeBill[]
  hostelAllocations    HostelAllocation[]
  hostelAttendances    HostelAttendance[]
  hostelGatePasses     HostelGatePass[]

  @@unique([batchId, rollNo])
  @@index([branchId, className])
  @@index([batchId])
  @@index([status])
  @@index([academicSession])
  @@index([organizationId])
  @@index([academicSessionId])
}

model TeacherProfile {
  organizationId     String              @default("org_default")
  id                 String              @id @default(cuid())
  userId             String              @unique
  employeeNo         String              @unique
  qualification      String?
  specialization     String?
  dateOfBirth       DateTime?           @db.Date
  branchId           String
  maxPeriodsPerDay   Int?
  maxPeriodsPerWeek  Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch             Branch              @relation(fields: [branchId], references: [id])
  batches            Batch[]
  studentAttendances Attendance[]
  attendances        TeacherAttendance[]
  timetables         Timetable[]
  homeworks          Homework[]
  examinations       Examination[]
  lmsLessons         Lesson[]
  allocations        TeacherAllocation[]
  subjects           TeacherSubject[]
  duties             TeacherDuty[]
  substitutionsAsOriginal TeacherSubstitution[] @relation("OriginalTeacherSubstitutions")
  substitutionsAsSubstitute TeacherSubstitution[] @relation("SubstituteTeacherSubstitutions")

  @@index([branchId, specialization])
  @@index([dateOfBirth])
  @@index([organizationId])
}

model TeacherAllocation {
  id                String                  @id @default(cuid())
  organizationId    String
  branchId          String
  academicSessionId String
  courseId          String
  batchId           String
  teacherId         String
  subjectId         String
  subjectName       String
  weeklyPeriods     Int
  effectiveFrom     DateTime                @db.Date
  effectiveTo       DateTime?               @db.Date
  remarks           String?                 @db.Text
  status            TeacherAllocationStatus @default(ACTIVE)
  createdById       String
  updatedById       String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch            Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  academicSession   AcademicSession         @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  course            Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch             Batch                   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  teacher           TeacherProfile          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject           Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("TeacherAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User                    @relation("TeacherAllocationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, academicSessionId])
  @@index([organizationId, branchId])
  @@index([organizationId, courseId])
  @@index([organizationId, batchId])
  @@index([organizationId, teacherId])
  @@index([organizationId, subjectId])
  @@index([organizationId, subjectName])
}

model Classroom {
  organizationId String      @default("org_default")
  id             String      @id @default(cuid())
  name           String
  code           String
  branchId       String
  capacity       Int         @default(30)
  building       String?
  floor          String?
  type           ClassroomType @default(CLASSROOM)
  remarks        String?     @db.Text
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  branch         Branch      @relation(fields: [branchId], references: [id])
  timetables     Timetable[]

  @@unique([branchId, code])
  @@index([branchId, isActive])
  @@index([organizationId])
}

model Timetable {
  organizationId    String          @default("org_default")
  id                String          @id @default(cuid())
  branchId          String
  courseId          String
  batchId           String
  subjectId         String
  teacherId         String
  classroomId       String
  day               TimetableDay
  startMinute       Int
  endMinute         Int
  periodNumber      Int
  academicSession   String
  academicSessionId String
  remarks           String?         @db.Text
  status            TimetableStatus @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  branch            Branch          @relation(fields: [branchId], references: [id])
  course            Course          @relation(fields: [courseId], references: [id])
  batch             Batch           @relation(fields: [batchId], references: [id])
  subject           Subject         @relation(fields: [subjectId], references: [id])
  teacher           TeacherProfile  @relation(fields: [teacherId], references: [id])
  classroom         Classroom       @relation(fields: [classroomId], references: [id])
  session           AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  homeworks         Homework[]
  substitutions     TeacherSubstitution[]

  @@unique([branchId, batchId, day, startMinute, endMinute])
  @@index([branchId, day])
  @@index([courseId])
  @@index([batchId, day])
  @@index([teacherId, day])
  @@index([academicSessionId])
  @@index([classroomId, day])
  @@index([status])
  @@index([organizationId])
}

model TimetablePeriod {
  organizationId    String              @default("org_default")
  id                String              @id @default(cuid())
  branchId          String
  academicSessionId String
  day               TimetableDay
  periodNumber      Int
  startMinute       Int
  endMinute         Int
  type              TimetablePeriodType @default(TEACHING)
  label             String?

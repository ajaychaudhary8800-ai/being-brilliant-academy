  condition      String
  hostel         Hostel               @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  room           HostelRoom?          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  damages        HostelDamageReport[]

  @@unique([hostelId, code])
  @@index([organizationId])
}

model HostelInspection {
  organizationId String     @default("org_default")
  id             String     @id @default(cuid())
  roomId         String
  inspectedAt    DateTime   @default(now())
  condition      String
  remarks        String?
  room           HostelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model HostelDamageReport {
  organizationId String      @default("org_default")
  id             String      @id @default(cuid())
  assetId        String
  description    String
  amountPaise    Int
  status         String      @default("OPEN")
  reportedAt     DateTime    @default(now())
  asset          HostelAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model HostelMaintenanceRequest {
  organizationId String     @default("org_default")
  id             String     @id @default(cuid())
  roomId         String
  title          String
  description    String
  priority       String
  status         String     @default("OPEN")
  createdAt      DateTime   @default(now())
  resolvedAt     DateTime?
  room           HostelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

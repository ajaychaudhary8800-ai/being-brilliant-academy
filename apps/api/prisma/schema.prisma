generator client {
  provider = "prisma-client-js"
}

model DoubtThread {
  organizationId    String         @default("org_default")
  id                String         @id @default(cuid())
  studentId         String
  subjectId         String?
  chapter           String?
  topic             String?
  title             String
  status            DoubtStatus    @default(OPEN)
  bookmarked        Boolean        @default(false)
  assignedTeacherId String?
  confidence        Decimal?       @db.Decimal(5, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  student           User           @relation("DoubtStudent", fields: [studentId], references: [id], onDelete: Cascade)
  assignedTeacher   User?          @relation("DoubtTeacher", fields: [assignedTeacherId], references: [id])
  messages          DoubtMessage[]

  @@index([organizationId, studentId, updatedAt])
  @@index([organizationId, subjectId, chapter])
  @@index([organizationId, status, assignedTeacherId])
}

model DoubtMessage {
  organizationId String      @default("org_default")
  id             String      @id @default(cuid())
  threadId       String
  authorId       String?
  role           String
  content        String      @db.Text
  attachmentName String?
  attachmentMime String?
  attachmentData Bytes?
  confidence     Decimal?    @db.Decimal(5, 2)
  sources        Json?
  createdAt      DateTime    @default(now())
  thread         DoubtThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author         User?       @relation(fields: [authorId], references: [id])

  @@index([organizationId, threadId, createdAt])
}

model QuestionBankItem {
  organizationId String                 @default("org_default")
  id             String                 @id @default(cuid())
  code           String
  examCategory   String
  type           QuestionType
  subjectId      String
  courseId       String?
  chapter        String
  topic          String?
  difficulty     String
  marks          Decimal                @db.Decimal(6, 2)
  negativeMarks  Decimal                @default(0) @db.Decimal(6, 2)
  year           Int?
  source         String?
  tags           String[]               @default([])
  bloomLevel     String?
  body           String                 @db.Text
  options        Json?
  correctAnswer  Json
  solution       String?                @db.Text
  approvalStatus ApprovalStatus         @default(DRAFT)
  version        Int                    @default(1)
  createdById    String
  reviewedById   String?
  reviewedAt     DateTime?
  isArchived     Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  createdBy      User                   @relation("QuestionCreator", fields: [createdById], references: [id])
  reviewedBy     User?                  @relation("QuestionReviewer", fields: [reviewedById], references: [id])
  revisions      QuestionBankRevision[]
  testQuestions  LearningTestQuestion[]

  @@unique([organizationId, code])
  @@index([organizationId, examCategory, subjectId, chapter])
  @@index([organizationId, difficulty, approvalStatus])
  @@index([organizationId, createdAt])
}

model QuestionBankRevision {
  organizationId String           @default("org_default")
  id             String           @id @default(cuid())
  questionId     String
  version        Int
  snapshot       Json
  changedById    String
  createdAt      DateTime         @default(now())
  question       QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, version])
  @@index([organizationId, questionId])
}

model LearningTest {
  organizationId  String                 @default("org_default")
  id              String                 @id @default(cuid())
  code            String
  name            String
  type            LearningTestType
  branchId        String?
  courseId        String
  batchId         String?
  subjectId       String?
  chapter         String?
  instructions    String?                @db.Text
  durationMinutes Int
  maximumMarks    Decimal                @db.Decimal(7, 2)
  passingMarks    Decimal                @db.Decimal(7, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  adaptive        Boolean                @default(false)
  status          LearningStatus         @default(DRAFT)
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdBy       User                   @relation(fields: [createdById], references: [id])
  questions       LearningTestQuestion[]
  attempts        LearningTestAttempt[]

  @@unique([organizationId, code])
  @@index([organizationId, courseId, batchId, status])
  @@index([organizationId, subjectId, chapter])
}

model LearningTestQuestion {
  organizationId String           @default("org_default")
  testId         String
  questionId     String
  section        String           @default("General")
  position       Int
  marks          Decimal          @db.Decimal(6, 2)
  negativeMarks  Decimal          @default(0) @db.Decimal(6, 2)
  test           LearningTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question       QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([testId, questionId])
  @@unique([testId, position])
  @@index([organizationId, testId, section])
}

model LearningTestAttempt {
  organizationId   String                @default("org_default")
  id               String                @id @default(cuid())
  testId           String
  studentId        String
  status           LearningAttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime              @default(now())
  expiresAt        DateTime
  submittedAt      DateTime?
  score            Decimal?              @db.Decimal(7, 2)
  percentage       Decimal?              @db.Decimal(6, 2)
  percentile       Decimal?              @db.Decimal(6, 2)
  rank             Int?
  correctCount     Int                   @default(0)
  incorrectCount   Int                   @default(0)
  unansweredCount  Int                   @default(0)
  timeSpentSeconds Int                   @default(0)
  test             LearningTest          @relation(fields: [testId], references: [id], onDelete: Restrict)
  student          User                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  answers          LearningTestAnswer[]

  @@unique([testId, studentId, startedAt])
  @@index([organizationId, studentId, submittedAt])
  @@index([organizationId, testId, score])
}

model LearningTestAnswer {
  organizationId   String              @default("org_default")
  id               String              @id @default(cuid())
  attemptId        String
  questionId       String
  answer           Json?
  markedForReview  Boolean             @default(false)
  bookmarked       Boolean             @default(false)
  timeSpentSeconds Int                 @default(0)
  awardedMarks     Decimal?            @db.Decimal(6, 2)
  isCorrect        Boolean?
  attempt          LearningTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([organizationId, attemptId])
}

model StudyMaterial {
  organizationId String                  @default("org_default")
  id             String                  @id @default(cuid())
  title          String
  description    String?                 @db.Text
  type           StudyMaterialType
  branchId       String?
  courseId       String
  batchId        String?
  subjectId      String?
  chapter        String?
  topic          String?
  teacherId      String?
  version        Int                     @default(1)
  status         LearningStatus          @default(DRAFT)
  tags           String[]                @default([])
  fileName       String?
  mimeType       String?
  fileSize       Int?
  fileData       Bytes?
  externalUrl    String?
  downloadCount  Int                     @default(0)
  isArchived     Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  bookmarks      StudyMaterialBookmark[]

  @@index([organizationId, courseId, batchId, status])
  @@index([organizationId, subjectId, chapter, type])
  @@index([organizationId, createdAt])
}

model StudyMaterialBookmark {
  organizationId String        @default("org_default")
  materialId     String
  userId         String
  createdAt      DateTime      @default(now())
  material       StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([materialId, userId])
  @@index([organizationId, userId])
}

model LiveClass {
  organizationId  String                 @default("org_default")
  id              String                 @id @default(cuid())
  title           String
  description     String?                @db.Text
  provider        LiveClassProvider
  meetingUrl      String
  meetingId       String?
  meetingPassword String?
  branchId        String
  courseId        String
  batchId         String
  subjectId       String
  teacherId       String
  startsAt        DateTime
  endsAt          DateTime
  recordingUrl    String?
  whiteboardUrl   String?
  status          LearningStatus         @default(DRAFT)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  attendances     LiveClassAttendance[]
  interactions    LiveClassInteraction[]

  @@index([organizationId, batchId, startsAt])
  @@index([organizationId, teacherId, startsAt])
  @@index([organizationId, status])
}

model LiveClassAttendance {
  organizationId  String    @default("org_default")
  id              String    @id @default(cuid())
  liveClassId     String
  userId          String
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationSeconds Int       @default(0)
  liveClass       LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveClassId, userId])
  @@index([organizationId, userId, joinedAt])
}

model LiveClassInteraction {
  organizationId String    @default("org_default")
  id             String    @id @default(cuid())
  liveClassId    String
  userId         String
  type           String
  content        Json?
  createdAt      DateTime  @default(now())
  liveClass      LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, liveClassId, createdAt])
}

model GamificationProfile {
  organizationId String    @default("org_default")
  id             String    @id @default(cuid())
  userId         String    @unique
  xp             Int       @default(0)
  coins          Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime? @db.Date
  level          Int       @default(1)
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, xp])
}

model LearningBadge {
  organizationId String         @default("org_default")
  id             String         @id @default(cuid())
  code           String
  name           String
  description    String
  icon           String?
  xpRequired     Int            @default(0)
  isActive       Boolean        @default(true)
  students       StudentBadge[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model StudentBadge {
  organizationId String        @default("org_default")
  badgeId        String
  userId         String
  awardedAt      DateTime      @default(now())
  badge          LearningBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([badgeId, userId])
  @@index([organizationId, userId])
}

model LearningChallenge {
  organizationId String              @default("org_default")
  id             String              @id @default(cuid())
  title          String
  description    String              @db.Text
  frequency      String
  target         Int
  xpReward       Int                 @default(0)
  coinReward     Int                 @default(0)
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean             @default(true)
  progress       ChallengeProgress[]

  @@index([organizationId, isActive, startsAt, endsAt])
}

model ChallengeProgress {
  organizationId String            @default("org_default")
  challengeId    String
  userId         String
  progress       Int               @default(0)
  completedAt    DateTime?
  challenge      LearningChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([organizationId, userId])
}

model LearningRecommendation {
  organizationId String    @default("org_default")
  id             String    @id @default(cuid())
  userId         String
  kind           String
  title          String
  reason         String    @db.Text
  entityType     String?
  entityId       String?
  priority       Int       @default(50)
  completedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, completedAt, priority])
}

model DailyLearningGoal {
  organizationId     String   @default("org_default")
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @db.Date
  targetMinutes      Int      @default(60)
  completedMinutes   Int      @default(0)
  targetQuestions    Int      @default(20)
  completedQuestions Int      @default(0)
  completed          Boolean  @default(false)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([organizationId, date])
}

model PremiumLead {
  organizationId String    @default("org_default")
  id             String    @id @default(cuid())
  name           String
  mobile         String
  email          String?
  className      String?
  targetExam     String?
  branchId       String?
  courseId       String?
  demoAt         DateTime?
  trialRequested Boolean   @default(false)
  couponCode     String?
  referralCode   String?
  emiRequested   Boolean   @default(false)
  source         String    @default("WEBSITE")
  leadScore      Int       @default(0)
  status         String    @default("NEW")
  crmSyncStatus  String    @default("PENDING")
  crmExternalId  String?
  utm            Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status, leadScore])
  @@index([organizationId, mobile, createdAt])
  @@index([organizationId, email])
}

model PremiumReferral {
  organizationId String    @default("org_default")
  id             String    @id @default(cuid())
  code           String
  ownerUserId    String?
  rewardPaise    Int       @default(0)
  referredCount  Int       @default(0)
  convertedCount Int       @default(0)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, code])
  @@index([organizationId, ownerUserId, isActive])
}

model PushSubscription {
  organizationId String   @default("org_default")
  id             String   @id @default(cuid())
  userId         String
  endpoint       String   @unique
  p256dh         String
  auth           String
  userAgent      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, userId, isActive])
}

model VideoTimestampBookmark {
  organizationId  String   @default("org_default")
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  positionSeconds Int
  label           String?
  note            String?  @db.Text
  createdAt       DateTime @default(now())

  @@unique([userId, lessonId, positionSeconds])
  @@index([organizationId, userId, lessonId])
}

model LessonAiAsset {
  organizationId String   @default("org_default")
  id             String   @id @default(cuid())
  lessonId       String
  type           String
  content        Json
  version        Int      @default(1)
  generatedAt    DateTime @default(now())

  @@unique([organizationId, lessonId, type])
  @@index([organizationId, lessonId])
}

model DailyEngagement {
  organizationId String   @default("org_default")
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  questionId     String?
  challengeTitle String
  challengeBody  String   @db.Text
  xpReward       Int      @default(10)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, date])
  @@index([organizationId, active, date])
}

model DailyEngagementResponse {
  organizationId String   @default("org_default")
  id             String   @id @default(cuid())
  engagementId   String
  userId         String
  answer         Json?
  correct        Boolean?
  completed      Boolean  @default(false)
  score          Int      @default(0)
  submittedAt    DateTime @default(now())

  @@unique([engagementId, userId])
  @@index([organizationId, userId, submittedAt])
  @@index([organizationId, engagementId, score])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  BRANCH_ADMIN
  TEACHER
  STUDENT
  PARENT
  EMPLOYEE
}

enum OrganizationSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Organization {
  id                     String                         @id @default(cuid())
  slug                   String                         @unique
  name                   String
  legalName              String?
  email                  String
  phone                  String?
  logoUrl                String?
  primaryColor           String                         @default("#1d4ed8")
  secondaryColor         String                         @default("#0f172a")
  timezone               String                         @default("Asia/Calcutta")
  locale                 String                         @default("en-IN")
  currency               String                         @default("INR")
  academicYearStartMonth Int                            @default(4)
  groupLabelType         GroupLabelType                 @default(BATCH)
  customGroupLabel       String?
  settings               Json                           @default("{}")
  subscriptionStatus     OrganizationSubscriptionStatus @default(TRIAL)
  subscriptionPlan       String                         @default("ENTERPRISE")
  trialEndsAt            DateTime?
  subscriptionEndsAt     DateTime?
  isActive               Boolean                        @default(true)
  deletedAt              DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  users                  User[]
  branches               Branch[]
  tenantAuditLogs        TenantAccessAudit[]
  academicSessions       AcademicSession[]
  teacherAllocations     TeacherAllocation[]
  timetablePeriods       TimetablePeriod[]
  teacherDuties          TeacherDuty[]
  substitutions          TeacherSubstitution[]
  examinationQuestionPapers ExaminationQuestionPaper[]
  examinationAnswerSheets ExaminationAnswerSheet[]

  @@index([subscriptionStatus, isActive])
}

model AcademicSession {
  organizationId String
  id             String           @id @default(cuid())
  name           String
  startsAt       DateTime         @db.Date
  endsAt         DateTime         @db.Date
  isCurrent      Boolean          @default(false)
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batches        Batch[]
  students       StudentProfile[]
  examinations   Examination[]
  timetables     Timetable[]
  teacherAllocations TeacherAllocation[]
  timetablePeriods TimetablePeriod[]
  teacherDuties TeacherDuty[]
  substitutions TeacherSubstitution[]

  @@unique([organizationId, name])
  @@index([organizationId, isCurrent])
  @@index([organizationId, isArchived, startsAt])
}

model TenantAccessAudit {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  method         String
  path           String
  ipAddress      String?
  userAgent      String?
  allowed        Boolean
  reason         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}


# Shared
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
INTERNAL_API_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000

# API / database
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bba?schema=public"
JWT_ACCESS_SECRET=replace-with-a-minimum-32-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-minimum-32-character-secret
COOKIE_SECRET=replace-with-a-minimum-32-character-secret
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
LOG_LEVEL=info
METRICS_TOKEN=
RATE_LIMIT_MAX=250
AUTH_RATE_LIMIT_MAX=10
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Being Brilliant Academy <noreply@example.com>"

# Payments and media (optional until the corresponding feature is enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

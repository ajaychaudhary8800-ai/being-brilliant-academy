{
  "name": "being-brilliant-academy",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter @bba/web --filter @bba/api dev",
    "build": "pnpm -r build",
    "start": "node apps/web/.next/standalone/apps/web/server.js",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r lint",
    "docker:config": "docker compose config --quiet",
    "docker:build": "docker compose build api web backup",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @bba/api prisma:generate",
    "db:migrate": "pnpm --filter @bba/api prisma:migrate",
    "db:seed": "pnpm --filter @bba/api prisma:seed",
    "test:integration:postgres": "pnpm --filter @bba/api exec tsx scripts/run-postgres-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:workflow": "playwright test --grep @workflow",
    "test:e2e:headed": "playwright test --headed",
    "launch:check": "node scripts/check-launch-readiness.mjs",
    "launch:require-go": "node scripts/check-launch-readiness.mjs --require-go"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}

{
  "name": "being-brilliant-academy",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22 <23" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "pnpm --parallel --filter @bba/web --filter @bba/api dev",
    "build": "pnpm -r build",
    "start": "node apps/web/.next/standalone/apps/web/server.js",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r lint",
    "docker:config": "docker compose config --quiet",
    "docker:build": "docker compose build api web backup",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @bba/api prisma:generate",
    "db:migrate": "pnpm --filter @bba/api prisma:migrate",
    "db:seed": "pnpm --filter @bba/api prisma:seed"
  },
  "devDependencies": { "typescript": "^5.7.3" }
}
